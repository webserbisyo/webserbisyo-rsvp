## 10. Filter Pattern

Use URL search params for filters.

```tsx
"use client";

import { useRouter, useSearchParams } from "next/navigation";

export function ApplicationsFilters() {
  const router = useRouter();
  const searchParams = useSearchParams();

  function setStatus(status: string) {
    const next = new URLSearchParams(searchParams);
    next.set("status", status);
    next.set("page", "1");

    router.push(`/admin/applications?${next.toString()}`);
  }

  return (
    <div className="flex gap-2">
      {/* filter controls */}
    </div>
  );
}
```

Rules:

- Use URL state for filters/pagination that should be shareable.
- Reset page to 1 when filters change.
- Validate filters on the server too.
- Do not use Zustand for table filters by default.

