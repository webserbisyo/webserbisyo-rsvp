## 6. Server Action Pattern

```ts
"use server";

import { revalidatePath } from "next/cache";
import { z } from "zod";
import { approveApplicationSchema } from "@/lib/validations/approval.schema";
import { approveApplication } from "@/server/services/approve-application";

export type ActionState = {
  ok: boolean;
  message?: string;
  fieldErrors?: Record<string, string>;
};

export async function approveApplicationAction(
  prevState: ActionState,
  formData: FormData,
): Promise<ActionState> {
  const parsed = approveApplicationSchema.safeParse({
    applicationId: formData.get("applicationId"),
    paymentReference: formData.get("paymentReference"),
    amountPaid: formData.get("amountPaid"),
  });

  if (!parsed.success) {
    return {
      ok: false,
      message: "Please check the form.",
      fieldErrors: Object.fromEntries(
        parsed.error.issues.map((issue) => [
          issue.path.join("."),
          issue.message,
        ]),
      ),
    };
  }

  // Check platform-admin permission here before calling service.
  await approveApplication(parsed.data);

  revalidatePath("/admin/applications");
  revalidatePath("/admin/clients");

  return {
    ok: true,
    message: "Application approved.",
  };
}
```

Rules:

- Validate with Zod.
- Check permissions server-side.
- Call services for workflows.
- Revalidate affected paths.
- Do not trust client-provided payment status, role, plan price, or client ID.

