## 8. Detail Page Pattern

```tsx
import { notFound } from "next/navigation";

type PageProps = {
  params: Promise<{ id: string }>;
};

export default async function ApplicationDetailPage({ params }: PageProps) {
  const { id } = await params;
  const application = await getAdminApplicationById(id);

  if (!application) {
    notFound();
  }

  return <ApplicationDetail application={application} />;
}
```

Recommended layout:

```txt
Header: back button, title, status, primary action
Summary cards: applicant, event, plan, payment
Details: message, event date, contact info
Activity: audit/email logs later
Danger/reject zone: reject/cancel actions
```

---

## 9. Table Pattern

Start with shadcn table.

```tsx
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";

export function ApplicationsTable({ applications }: Props) {
  if (applications.length === 0) {
    return <EmptyState title="No applications yet" />;
  }

  return (
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>Applicant</TableHead>
          <TableHead>Event type</TableHead>
          <TableHead>Plan</TableHead>
          <TableHead>Status</TableHead>
          <TableHead>Submitted</TableHead>
          <TableHead className="text-right">Actions</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {applications.map((application) => (
          <TableRow key={application.id}>
            <TableCell>{application.full_name}</TableCell>
            <TableCell>{application.event_type}</TableCell>
            <TableCell>{application.preferred_plan}</TableCell>
            <TableCell>
              <ApplicationStatusBadge status={application.status} />
            </TableCell>
            <TableCell>{application.created_at}</TableCell>
            <TableCell className="text-right">
              <ApplicationActions application={application} />
            </TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}
```

Use TanStack Table only when you need:

```txt
column sorting
column visibility
row selection
bulk actions
complex client-side filtering
large reusable table framework
```

Do not install TanStack Table for simple admin MVP tables.

